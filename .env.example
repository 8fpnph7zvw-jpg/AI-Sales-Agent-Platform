# Copy this file to .env before starting.
# Never commit the populated .env file.

# Compose / public entry point
COMPOSE_PROJECT_NAME=ai-sales-agent
IMAGE_TAG=local
HTTP_PORT=80
TZ=Asia/Shanghai

# Application
APP_ENV=production
LOG_LEVEL=INFO
BACKEND_WORKERS=2
CORS_ORIGINS=http://localhost

# MySQL
MYSQL_DATABASE=ai_sales_agent
MYSQL_USER=ai_sales_agent
MYSQL_PASSWORD=AiAgent2026@Mysql
MYSQL_ROOT_PASSWORD=Root2026@Mysql
# URL-encode reserved characters in username/password before placing them in this URL.
DATABASE_URL=mysql+asyncmy://ai_sales_agent:AiAgent2026%40Mysql@mysql:3306/ai_sales_agent?charset=utf8mb4

# Redis
REDIS_PASSWORD=AiAgent2026@Redis
REDIS_URL=redis://:AiAgent2026%40Redis@redis:6379/0

# Authentication
# Required: at least 32 cryptographically random characters.
JWT_SECRET=0e33f9f8227ba335455cda4530b4a0be94ed9f09037f2a5536039d07696a4c60
# Password used only when initialize_demo.py creates admin@test.com for the first time.
DEMO_ADMIN_PASSWORD=Admin@2026
JWT_ISSUER=ai-sales-agent-platform
JWT_AUDIENCE=ai-sales-agent-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dify Agent API - backend only; never expose this value as a VITE_ variable.
DIFY_API_BASE_URL=https://api.dify.ai/v1
# App API Key from the Dify application's API Access page; do not use a Dataset key.
DIFY_API_KEY=app-pBS9J1xYaOIfJ1ybLfzsiGrq
DIFY_TIMEOUT_SECONDS=30

# WhatsApp processing limits
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=15
WHATSAPP_PROCESSING_TIMEOUT_SECONDS=60
WHATSAPP_WEBHOOK_MAX_BYTES=1048576
WHATSAPP_GATEWAY_URL=http://whatsapp-connector:3001
# Required shared secret used only between FastAPI and whatsapp-connector.
WHATSAPP_GATEWAY_TOKEN=ai-sales-whatsapp-2026-long-secret-8f92kdk39
WHATSAPP_GATEWAY_TIMEOUT_SECONDS=20
WHATSAPP_AUTO_CONNECT=false
WHATSAPP_AI_RETRY_WORKER_ENABLED=true
WHATSAPP_AI_RETRY_POLL_SECONDS=2
WHATSAPP_AI_RETRY_MAX_DELAY_SECONDS=300

# URL-safe base64 encoding of exactly 32 random bytes.
CONFIG_ENCRYPTION_KEY=Og+JZeA7vGRi8Hro2e88yQdiEzSXJhjBkJ/cpF1AEtc=
CONFIG_ENCRYPTION_KEY_VERSION=v1

# RAG / Chroma vector database
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=ai_sales_knowledge
CHROMA_ENABLED=true
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_UPLOAD_BYTES=20971520

# Frontend build-time public configuration
VITE_API_BASE_URL=/api/v1
