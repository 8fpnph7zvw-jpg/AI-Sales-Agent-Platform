# Copy this file to .env before starting.
# Never commit the populated .env file.

# Compose / public entry point
COMPOSE_PROJECT_NAME=ai-sales-agent
IMAGE_TAG=local
HTTP_PORT=80
TZ=Asia/Shanghai

# Application
APP_ENV=production
LOG_LEVEL=INFO
BACKEND_WORKERS=2
CORS_ORIGINS=http://localhost

# MySQL
MYSQL_DATABASE=ai_sales_agent
MYSQL_USER=ai_sales_agent
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# URL-encode reserved characters in username/password before placing them in this URL.
DATABASE_URL=mysql+asyncmy://ai_sales_agent:replace-with-a-strong-database-password@mysql:3306/ai_sales_agent?charset=utf8mb4

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:replace-with-a-strong-redis-password@redis:6379/0

# Authentication
# Required: at least 32 cryptographically random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Password used only when initialize_demo.py creates admin@test.com for the first time.
DEMO_ADMIN_PASSWORD=Admin@2026
JWT_ISSUER=ai-sales-agent-platform
JWT_AUDIENCE=ai-sales-agent-api
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Dify Agent API - backend only; never expose this value as a VITE_ variable.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
DIFY_TIMEOUT_SECONDS=30

# OpenWA WhatsApp API - backend only; OPENWA_URL uses the Docker service name.
OPENWA_URL=http://openwa:2785/api
# Filled automatically by the openwa-init one-shot service after OpenWA first boot.
OPENWA_API_KEY=
OPENWA_SESSION=
OPENWA_SESSION_NAME=ai-sales-agent
OPENWA_PORT=2785
OPENWA_ENGINE_TYPE=whatsapp-web.js
OPENWA_RECONNECT_BASE_DELAY_MS=5000
OPENWA_RECONNECT_MAX_DELAY_MS=60000
OPENWA_INITIALIZE_TIMEOUT_MS=90000
# OpenWA posts ready/authenticated/disconnected events to the backend automatically.
# The Docker Compose default points to the internal backend service.

# WhatsApp processing limits
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TIMEOUT_SECONDS=15
WHATSAPP_PROCESSING_TIMEOUT_SECONDS=60
WHATSAPP_WEBHOOK_MAX_BYTES=1048576

# URL-safe base64 encoding of exactly 32 random bytes.
CONFIG_ENCRYPTION_KEY=replace-with-url-safe-base64-32-byte-key
CONFIG_ENCRYPTION_KEY_VERSION=v1

# RAG / Chroma vector database
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=ai_sales_knowledge
CHROMA_ENABLED=true
RAG_EMBEDDING_DIMENSIONS=384
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_MAX_UPLOAD_BYTES=20971520

# Frontend build-time public configuration
VITE_API_BASE_URL=/api/v1
