# FastAPI base URL. The connector appends /conversations/message.
BACKEND_API_URL=http://localhost:8000/api/v1
BACKEND_CONNECTOR_ID=
BACKEND_API_TOKEN=

# Dify is called by FastAPI. These values are reserved for deployments that
# inject all AI integration settings from one environment file.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=

PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# LocalAuth / multi-account defaults
WHATSAPP_SESSION_ID=customer001
WHATSAPP_AUTO_CONNECT=true
WHATSAPP_SESSIONS_PATH=./sessions
WHATSAPP_ACCEPT_GROUP_MESSAGES=false

# Protects /api/whatsapp/send when set. Use the same value in FastAPI as
# WHATSAPP_GATEWAY_TOKEN.
CONNECTOR_API_TOKEN=

# Browser configuration
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_HEADLESS=true
PUPPETEER_NO_SANDBOX=false

# Optional browser access for a separately hosted frontend.
CORS_ORIGIN=http://localhost:5173
